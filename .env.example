# Copy this file to .env and fill in real values. Never commit .env — it is gitignored.
#
# Secrets-loading convention: every module reads secrets via `os.environ`, populated at process
# start from `.env` through `python-dotenv` (see engine/data or market_overlay client modules).
# No secret is ever hardcoded in source, passed as a CLI arg, or committed in a snapshot/log.
#
# Not needed for Phases 1-3: the backtestable core (FPL API + Understat) requires no key at all.
# Only the Phase 4b live market overlay (market_overlay/odds_client.py) reads these, and only at
# decision time, once per gameweek — never during backtesting.

# API key for the pre-match odds provider used by the Phase 4b market overlay.
ODDS_API_KEY=

# Base URL for that provider, if it differs from the provider's documented default.
ODDS_API_BASE_URL=
